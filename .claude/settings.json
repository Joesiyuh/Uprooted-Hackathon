{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python",
            "args": ["${CLAUDE_PROJECT_DIR}/src/hook_guard.py"],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
